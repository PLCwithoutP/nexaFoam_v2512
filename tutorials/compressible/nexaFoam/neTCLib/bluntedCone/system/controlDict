FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../0/initialConditions"

application     nexaFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2e-04;

deltaT          1e-10;

writeControl    adjustableRunTime;

writeInterval   1e-07;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

graphFormat     raw;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1e-05;

functions
{

    cp_surface
    {
        type            nePressureCoefficient;
        libs            ("libnexaFieldFunctionObjects.so");

        rhoInf          5.113e-4;
        magUInf         2764.5;

        patches         (cone);      // omit for all walls
        writeControl    writeTime;
        log             yes;
    }
    
    tau_surface
    {
        type            neWallShearStress;
        libs            ("libnexaFieldFunctionObjects.so");
        patches         (cone);
        writeControl    writeTime;
    }
    
    cf_surface
    {
        type            neFrictionCoefficient;
        libs            ("libnexaFieldFunctionObjects.so");
        rhoInf          5.113e-4;
        magUInf         2764.5;
        wallShearStress tau_surface;
        patches         (cone);
        writeControl    writeTime;
    }
    
    coneSurface
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    writeTime;
        surfaceFormat   raw;
        interpolate     false;       // face-centre values, no blending
        fields          (p muLam cp_surface tau_surface cf_surface);
        surfaces
        (
            cone
            {
                type    patch;
                patches (cone);
            }
        );
    }
}


