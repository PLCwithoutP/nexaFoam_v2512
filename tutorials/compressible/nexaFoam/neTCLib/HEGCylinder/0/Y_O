FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Y_O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [0 0 0 0 0 0 0];

internalField   uniform $O_mass_fraction;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $O_mass_fraction;
    }

    cylinder
    {
        type            zeroGradient;
    }

    over
    {
        type            empty;
    }

    under
    {
        type            empty;
    }

    outlet
    {
        type            zeroGradient;
    }

	symmBC
	{
		type			symmetry;
	}
}


